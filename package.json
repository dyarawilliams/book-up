{
  "name": "book-up",
  "version": "1.0.0",
  "description": "A simple Rest API creating a book directory.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile:sass": "sass --watch --no-source-map scss:public/css",
    "build:css": "sass --no-source-map scss:public/css",
    "build:postcss": "postcss public/css/styles.css -o public/css/styles.min.css --no-map",
    "build": "npm run build:css && NODE_ENV=production npm run build:postcss"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyarawilliams/book-up.git"
  },
  "keywords": [
    "REST",
    "API",
    "book",
    "directory"
  ],
  "author": "D'yara Williams",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dyarawilliams/book-up/issues"
  },
  "homepage": "https://github.com/dyarawilliams/book-up#readme",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "method-override": "^3.0.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "autoprefixer": "^10.6.2",
    "cssnano": "^7.1.9",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.106.1"
  },
  "overrides": {
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.2": "4.0.7",
    "readdirp": {
      "picomatch": "2.3.2"
    }
  }
}
