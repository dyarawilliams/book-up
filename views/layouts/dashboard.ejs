<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bookup | <%= title %>
  </title>
  <meta name="description"
    content="Bookup Dashboard is your go-to destination for discovering and exploring a vast collection of books">
  <meta name="keywords"
    content="bookup, book directory, book, bookup dashboard, dashboard, crud, directory, D'yara Williams, dyara williams">
  <%- include('../partials/perf-head') %>
  <% if (locals.loadUploader) { %>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="stylesheet" href="https://unpkg.com/filepond@4.32.12/dist/filepond.css" />
  <link rel="stylesheet" href="https://unpkg.com/filepond-plugin-image-preview@4.6.12/dist/filepond-plugin-image-preview.css" />
  <% } %>
</head>

<body>
  <%- include('../partials/header') %>
  <main class="dashboard container mb-4">
    <%- include('../partials/errorMessage') %>
      <%- body %>
  </main>
  <%- include('../partials/footer') %>

  <%- include('../partials/perf-scripts') %>
</body>

</html>