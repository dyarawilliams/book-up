<section class="error-content py-5">
    <div class="container">
        <div class="error-text">
            <h2><%= status %> Error</h2>
            <h3 class="error-subtitle">Something went wrong</h3>
            <p class="error-info">The server could not finish this request. Please try again in a moment.</p>
            <a href="/" class="btn btn-primary btn-round">Go to homepage</a>
        </div>
    </div>
</section>
