<h1 class="text-center pt-3 pb-3">MY BOOKS ADDED</h1>

<table class="table content-table">
    <thead>
        <tr class="text-white">
            <th scope="col">Cover</th>
            <th scope="col">Title & Author</th>
            <th scope="col">Page Count</th>
            <th scope="col">Rating</th>
            <th scope="col">Date added</th>
        </tr>
    </thead>
    <tbody>
        <% books.forEach((book, index) => { %>
            <tr>
                <td scope="row"><img src="<%= book.coverImagePath %>" class="img-fluid" width="70" height="93" alt="Book Cover" loading="<%= index === 0 ? 'eager' : 'lazy' %>"<% if (index === 0) { %> fetchpriority="high"<% } else { %> decoding="async"<% } %>></td>
                <td class="w-50">
                    <%= book.title %><br>
                    By: <%= book.author.name %>
                </td>
                <td><%= book.pageCount %></td>
                <td><%= book.rating %></td>
                <td><%= book.dateAdded %></td>
            </tr>
        <% }) %>
    </tbody>
</table>